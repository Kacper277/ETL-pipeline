# PostgreSQL connection settings
# NOTE: POSTGRES_PORT is the host port published by docker-compose.
# If 5432 is already taken on your machine (e.g. a local PostgreSQL
# service), set it to 5433 and mirror that in DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=
POSTGRES_DB=weather_db

# SQLAlchemy connection string (used by the load module)
DATABASE_URL=postgresql+psycopg2://etl_user:CHANGE_ME@localhost:5432/weather_db

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Pipeline parameters
# FORECAST_DAYS: 1-16 (Open-Meteo maximum)
# PAST_DAYS: 0-92 (~3 months of past data, Open-Meteo maximum)
LATITUDE=52.23
LONGITUDE=21.01
FORECAST_DAYS=16
PAST_DAYS=92

# ------------------------------------------------------------------
# Kafka streaming path
#
# TWO bootstrap addresses on purpose: the broker advertises two
# listeners. From INSIDE Docker (other containers) use the service
# name; from the HOST machine (local scripts, pytest, CI) use
# localhost - the EXTERNAL listener advertises localhost:9092.
# ------------------------------------------------------------------
# Kafka - from inside Docker (other containers)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Kafka - from the host machine (local scripts, pytest)
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
# NOTE: when running produce_demo / consume ON THE HOST, override with:
#   $env:KAFKA_BOOTSTRAP_SERVERS = "localhost:9092"        (PowerShell)
#   export KAFKA_BOOTSTRAP_SERVERS=localhost:9092          (bash)
KAFKA_TOPIC_RAW=weather.readings.raw
KAFKA_TOPIC_PROCESSED=weather.readings.processed
KAFKA_TOPIC_DLQ=weather.readings.dlq
KAFKA_CONSUMER_GROUP=weather-ingest-v1
KAFKA_BATCH_SIZE=50
KAFKA_BATCH_TIMEOUT_S=5
