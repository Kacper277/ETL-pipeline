# PostgreSQL connection settings
# NOTE: POSTGRES_PORT is the host port published by docker-compose.
# If 5432 is already taken on your machine (e.g. a local PostgreSQL
# service), set it to 5433 and mirror that in DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=
POSTGRES_DB=weather_db

# SQLAlchemy connection string (used by the load module)
DATABASE_URL=postgresql+psycopg2://etl_user:CHANGE_ME@localhost:5432/weather_db

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Pipeline parameters
# FORECAST_DAYS: 1-16 (Open-Meteo maximum)
# PAST_DAYS: 0-92 (~3 months of past data, Open-Meteo maximum)
LATITUDE=52.23
LONGITUDE=21.01
FORECAST_DAYS=16
PAST_DAYS=92
